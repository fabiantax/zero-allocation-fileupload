<Project>

  <!-- Applies to src/ only. Test and benchmark projects deliberately inherit none of this:
       requiring XML comments on every test method is noise, not documentation. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 = missing XML comment on a public member. An error, not a warning, so the
         documentation cannot silently regress once written. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>


  <!-- src/ only. Test methods are not judged on length, and a benchmark's shape is dictated
       by BenchmarkDotNet. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.18.0.131500">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../tools/FileMutation.Analyzers/FileMutation.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
