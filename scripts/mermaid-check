#!/bin/sh
# Parse-check every mermaid fence in tracked markdown with mermaid's own parser (mmdc).
# Exit non-zero on the first parse error, naming the source file and diagram number.
# Scope: structural AND full syntax (this is the real renderer's parser, not a regex).
set -u

command -v npx >/dev/null 2>&1 || { echo "mermaid-check: npx is required" >&2; exit 2; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

python3 - "$tmp" <<'EOF'
import subprocess, sys, pathlib
tmp = pathlib.Path(sys.argv[1])
files = subprocess.run(["git", "ls-files", "*.md"], capture_output=True, text=True, check=True).stdout.split()
n = 0
for md in files:
    text = pathlib.Path(md).read_text()
    parts = text.split("```mermaid\n")[1:]
    for i, part in enumerate(parts, 1):
        body = part.split("```", 1)[0]
        n += 1
        (tmp / f"{n:03d}.mmd").write_text(body)
        (tmp / f"{n:03d}.src").write_text(f"{md} (mermaid block {i})")
print(n)
EOF

count=$(ls "$tmp"/*.mmd 2>/dev/null | wc -l | tr -d ' ')
[ "$count" -gt 0 ] || { echo "mermaid-check: no mermaid diagrams found"; exit 0; }

fail=0
for mmd in "$tmp"/*.mmd; do
    src=$(cat "${mmd%.mmd}.src")
    if ! npx -y @mermaid-js/mermaid-cli -i "$mmd" -o "${mmd%.mmd}.svg" >/dev/null 2>&1; then
        echo "mermaid-check: PARSE ERROR in $src" >&2
        fail=1
    fi
done

[ "$fail" -eq 0 ] && echo "mermaid-check: $count/$count diagrams parse"
exit "$fail"
