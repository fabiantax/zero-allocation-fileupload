root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:suggestion
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion

# SonarAnalyzer — function size and shape. Enforced by the build, not by whoever reads the PR.
# See issue #32. Applies to src/ only; the package is referenced from src/Directory.Build.props.
[src/**.cs]

# S3776 cognitive complexity. The one that matters: it measures nesting and branching, not
# length. A long flat sequence of steps is readable; a short deeply nested one is not.
# Sonar's default of 15 is kept — it is the value their own research settled on.
dotnet_diagnostic.S3776.severity = error

# S138 method length, at Sonar's default of 80. A correction: an earlier revision of this file
# claimed the threshold was lowered to 60, but only the severity line ever took effect —
# SonarAnalyzer enforces 80. Lowering it needs a rule-parameter mechanism this setup does not
# have, so the claim is removed rather than kept untrue. S3776 (cognitive complexity) is the
# rule that actually polices shape; S138 is the backstop.
dotnet_diagnostic.S138.severity = error

# S1541 cyclomatic complexity, kept at the default of 10.
dotnet_diagnostic.S1541.severity = error
